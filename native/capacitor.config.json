{
  "appId": "uk.org.clearspring.app",
  "appName": "Clearspring",
  "webDir": "www",
  "appendUserAgent": "ClearspringApp/1.0",
  "server": {
    "url": "https://clearspringchurchapp.onrender.com",
    "cleartext": false,
    "errorPath": "offline.html",
    "allowNavigation": [
      "clearspringchurchapp.onrender.com"
    ]
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#F5F8F7",
    "limitsNavigationsToAppBoundDomains": true
  },
  "android": {
    "backgroundColor": "#F5F8F7",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#F5F8F7",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    },
    "FirebaseMessaging": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        }
      }
    }
  }
}
